rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /price_standards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /partner_locations/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /alert_zones/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Written only by the scheduled Cloud Function (syncTravelAlerts, via
    // the Admin SDK, which bypasses these rules) — never by app clients.
    match /travel_alerts_cache/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Cross-device record of a purchase, filed under the store's own
    // transaction id (see EntitlementRepository).
    //
    // 🚨 **Obsolete since 2026-08-30.** It existed because the products were
    // one-time consumables, which the stores do not replay on a new device the
    // way a subscription is replayed — so "Restore Purchases" had nothing to
    // restore. Both products are auto-renewing subscriptions now and both
    // stores answer that question themselves. Task 2.8 should stop writing
    // here and drop `create` to `if false`; nothing reads it at runtime yet.
    //
    // The product id list below is kept correct in the meantime rather than
    // left pointing at a retired id, because a rule that silently rejects
    // every write is a worse failure than one that is merely unnecessary.
    //
    // 🚨 These rules are permissive on purpose and are NOT a security boundary.
    // The app has no Firebase Auth (§7), so there is no identity to check
    // against, and a determined client can write a document granting itself a
    // pass. That is tolerable only because the store receipt is the source of
    // truth: Phase 2C task 2.8 validates the receipt server-side, at which
    // point the write below moves into a Cloud Function (which bypasses these
    // rules via the Admin SDK) and `create` drops to `if false`.
    //
    // Until then the damage is bounded by the shape checks: a document must
    // name a known product and carry an expiry, `update` and `delete` are
    // refused outright so an existing record cannot be extended, and reads
    // give nothing away — a transaction id is not guessable and identifies no
    // one.
    match /entitlements/{purchaseId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['product_id', 'expires_at', 'platform', 'recorded_at'])
                    && request.resource.data.product_id in [
                         'thaishield_premium_weekly',
                         'thaishield_premium_monthly'
                       ]
                    && request.resource.data.expires_at is timestamp;
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
